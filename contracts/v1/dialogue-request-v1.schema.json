{
  "$id": "https://cyber-town.local/schemas/v1/dialogue-request-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A single idempotent player-to-NPC dialogue command.",
  "properties": {
    "conversation_id": {
      "format": "uuid",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Conversation Id",
      "type": "string"
    },
    "message": {
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "^(?:\\S|\\S[\\s\\S]{0,998}\\S)$",
      "title": "Message",
      "type": "string"
    },
    "npc_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^(?:neon_guide|signal_archivist|night_courier)$",
      "title": "Npc Id",
      "type": "string"
    },
    "player_id": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
      "title": "Player Id",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "player_id",
    "npc_id",
    "conversation_id",
    "message"
  ],
  "title": "DialogueRequestV1",
  "type": "object"
}
